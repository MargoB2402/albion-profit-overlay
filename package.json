{
  "name": "albion-profit-overlay",
  "version": "1.4.0",
  "description": "Albion Profit — Game Overlay",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite --port 3001\" \"cross-env NODE_ENV=development electron .\"",
    "icons":     "node scripts/make-icons.mjs",
    "build":     "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false node scripts/make-icons.mjs && vite build && node scripts/obfuscate.mjs && electron-builder",
    "build:dir": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false node scripts/make-icons.mjs && vite build && node scripts/obfuscate.mjs && electron-builder --dir",
    "preview":   "vite preview",
    "release":   "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false node scripts/make-icons.mjs && vite build && node scripts/obfuscate.mjs && electron-builder --publish always"
  },
  "build": {
    "appId": "sbs.promptly.overlay",
    "productName": "Albion Profit Overlay",
    "copyright": "Copyright © 2026 Albion Profit",
    "asar": true,
    "asarUnpack": ["assets/agent.exe"],
    "afterPack": "scripts/post-build.mjs",
    "files": [
      "dist/**",
      "main.obf.js",
      "preload.obf.js",
      "assets/**"
    ],
    "extraMetadata": {
      "main": "main.obf.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "assets/icon.ico",
      "signingHashAlgorithms": null,
      "sign": null
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Albion Profit Overlay"
    },
    "publish": {
      "provider": "github",
      "owner": "MargoB2402",
      "repo": "albion-profit-overlay",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^4.2.2",
    "png-to-ico": "^3.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.3.3"
  }
}
