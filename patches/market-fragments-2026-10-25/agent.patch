@@ -0,0 +1,115 @@
+package photon
+
+import (
+	"encoding/binary"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func fragmentPacket(channel byte, seq, count, number, total, offset uint32, part []byte) []byte {
+	b := make([]byte, 44+len(part))
+	b[3] = 1
+	b[12] = 8
+	b[13] = channel
+	binary.BigEndian.PutUint32(b[16:], uint32(32+len(part)))
+	for i, v := range []uint32{seq, count, number, total, offset} {
+		binary.BigEndian.PutUint32(b[24+i*4:], v)
+	}
+	copy(b[44:], part)
+	return b
+}
+
+func TestLargeMarketPageOutOfOrderWithRetransmissions(t *testing.T) {
+	orders := make([]string, 20)
+	message := []byte{0, MsgResponse, 75, 0, 0, 0x47, 20}
+	for i := range orders {
+		orders[i] = `{"ItemTypeId":"T4_BAG","UnitPriceSilver":10000,"LocationId":"4000","Padding":"` + strings.Repeat("x", 400) + `"}`
+		n := uint32(len(orders[i]))
+		for n >= 128 {
+			message = append(message, byte(n)|128)
+			n >>= 7
+		}
+		message = append(message, byte(n))
+		message = append(message, orders[i]...)
+	}
+	calls := 0
+	p := NewPhotonParser(nil, func(_ byte, _ int16, _ string, params map[byte]interface{}) {
+		calls++
+		if !reflect.DeepEqual(params[0], orders) {
+			t.Fatal("market page corrupted")
+		}
+	}, nil)
+	const chunk = 600
+	count := (len(message) + chunk - 1) / chunk
+	for i := count - 1; i >= 0; i-- {
+		start := i * chunk
+		end := start + chunk
+		if end > len(message) {
+			end = len(message)
+		}
+		b := fragmentPacket(2, 99, uint32(count), uint32(i), uint32(len(message)), uint32(start), message[start:end])
+		p.ReceivePacket(b)
+		if i > 0 {
+			p.ReceivePacket(b)
+		}
+	}
+	if calls != 1 {
+		t.Fatal("large page must arrive exactly once after complete coverage", calls)
+	}
+}
+
+func TestFragmentBoundsAndConflictingOverlap(t *testing.T) {
+	p := NewPhotonParser(nil, nil, nil)
+	for _, b := range [][]byte{fragmentPacket(0, 1, 2, 0, 0xffffffff, 0, []byte{1}), fragmentPacket(0, 2, 0, 0, 10, 0, []byte{1}), fragmentPacket(0, 3, 2, 0, 10, 11, []byte{1})} {
+		p.ReceivePacket(b)
+	}
+	if len(p.pendingSegments) != 0 {
+		t.Fatal("malformed fragment allocated an assembly")
+	}
+	p.ReceivePacket(fragmentPacket(0, 4, 2, 0, 10, 0, []byte{1, 2, 3}))
+	p.ReceivePacket(fragmentPacket(0, 4, 2, 1, 10, 2, []byte{4, 5, 6}))
+	if len(p.pendingSegments) != 0 {
+		t.Fatal("conflicting overlap retained an assembly")
+	}
+	for i := uint32(10); i < 30; i++ {
+		p.ReceivePacket(fragmentPacket(0, i, 2, 0, 10, 0, []byte{1}))
+	}
+	if len(p.pendingSegments) > 8 {
+		t.Fatal("unbounded incomplete assemblies")
+	}
+}
+
+func TestFragmentsRequireUniqueCoverage(t *testing.T) {
+	// A response split in the middle of a string, including a retransmission.
+	message := []byte{0, 3, 2, 0, 0, 8, 1, 8, 7, 4, 'z', 'o', 'n', 'e'}
+	calls := 0
+	var zone interface{}
+	p := NewPhotonParser(nil, func(_ byte, _ int16, _ string, params map[byte]interface{}) { calls++; zone = params[8] }, nil)
+	a := fragmentPacket(0, 7, 2, 0, uint32(len(message)), 0, message[:7])
+	b := fragmentPacket(0, 7, 2, 1, uint32(len(message)), 7, message[7:])
+	p.ReceivePacket(a)
+	p.ReceivePacket(a)
+	if calls != 0 {
+		t.Fatal("duplicate fragment delivered an incomplete market response")
+	}
+	p.ReceivePacket(b)
+	if calls != 1 || zone != "zone" {
+		t.Fatal("full response not recovered after retransmission", calls, zone)
+	}
+}
+
+func TestFragmentChannelsDoNotMix(t *testing.T) {
+	message := []byte{0, 3, 2, 0, 0, 8, 1, 8, 7, 4, 'z', 'o', 'n', 'e'}
+	calls := 0
+	p := NewPhotonParser(nil, func(byte, int16, string, map[byte]interface{}) { calls++ }, nil)
+	p.ReceivePacket(fragmentPacket(0, 7, 2, 0, 14, 0, message[:7]))
+	p.ReceivePacket(fragmentPacket(1, 7, 2, 1, 14, 7, message[7:]))
+	if calls != 0 {
+		t.Fatal("fragments from different channels were mixed")
+	}
+	p.ReceivePacket(fragmentPacket(0, 7, 2, 1, 14, 7, message[7:]))
+	if calls != 1 {
+		t.Fatal("valid same-channel response missing")
+	}
+}
