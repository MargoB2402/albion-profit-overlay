+package client
+
+import "testing"
+
+func TestTakeAllLateMembership(t *testing.T) {
+	f := newLootCapture()
+	f.player = "Alice"
+	f.location = "dungeon"
+	f.inventory = "inventory"
+	f.sources[900] = lootSource{kind: "chest"}
+	f.containers["chest"] = lootContainer{source: 900, items: []int64{201}}
+	f.itemSources[201] = 900
+	var out []map[string]interface{}
+	f.sink = func(r map[string]interface{}) { out = append(out, r) }
+	for _, id := range []int64{201, 202} {
+		f.items[id] = lootItem{kind: 500 + id, quantity: 2, quality: 1, at: 1000}
+	}
+	f.moves["batch"] = &lootMove{code: uint16(opInventoryMoveGivenItems), source: "chest", destination: "inventory", objects: []int64{201, 202}, amounts: map[int64]int64{201: 2, 202: 2}, removed: map[int64]bool{}, arrived: map[int64]bool{}, at: 1000, confirmed: true}
+	f.replayMoves(1001)
+	if len(out) != 1 {
+		t.Fatal(out)
+	}
+	f.itemSources[202] = 900
+	f.replayMoves(1002)
+	if len(out) != 2 {
+		t.Fatal("late membership lost part of take all", out)
+	}
+	f.replayMoves(1003)
+	if len(out) != 2 {
+		t.Fatal("duplicate")
+	}
+}
+func TestTakeAllPartialArrival(t *testing.T) {
+	f := newLootCapture()
+	f.player = "Alice"
+	f.location = "dungeon"
+	f.inventory = "11111111-1111-4111-8111-111111111111"
+	f.sources[900] = lootSource{kind: "chest"}
+	f.containers["chest"] = lootContainer{source: 900, items: []int64{201, 202}}
+	var out []map[string]interface{}
+	f.sink = func(r map[string]interface{}) { out = append(out, r) }
+	for _, id := range []int64{201, 202} {
+		f.items[id] = lootItem{kind: 500 + id, quantity: 2, quality: 1, at: 1000}
+		f.itemSources[id] = 900
+	}
+	f.moves["batch"] = &lootMove{code: uint16(opInventoryMoveGivenItems), source: "chest", destination: f.inventory, objects: []int64{201, 202}, amounts: map[int64]int64{}, removed: map[int64]bool{}, arrived: map[int64]bool{}, at: 1000}
+	f.event(uint16(evInventoryPutItem), map[byte]interface{}{0: int64(201), 2: f.inventory}, 1001)
+	if len(out) != 1 {
+		t.Fatal("one arrival must not confirm all objects", out)
+	}
+}
