+package client
+
+import (
+	"github.com/ao-data/albiondata-client/client/photon"
+	"github.com/google/gopacket"
+	"github.com/google/gopacket/layers"
+	"github.com/google/gopacket/pcap"
+	"strings"
+	"testing"
+	"time"
+)
+
+func ipFragmentFixture(t *testing.T, id uint16, offset uint16, more bool, data []byte) gopacket.Packet {
+	t.Helper()
+	ip := &layers.IPv4{Version: 4, IHL: 5, Id: id, FragOffset: offset, SrcIP: []byte{1, 2, 3, 4}, DstIP: []byte{5, 6, 7, 8}, Protocol: layers.IPProtocolUDP}
+	if more {
+		ip.Flags = layers.IPv4MoreFragments
+	}
+	b := gopacket.NewSerializeBuffer()
+	if err := gopacket.SerializeLayers(b, gopacket.SerializeOptions{FixLengths: true, ComputeChecksums: true}, ip, gopacket.Payload(data)); err != nil {
+		t.Fatal(err)
+	}
+	return gopacket.NewPacket(b.Bytes(), layers.LayerTypeIPv4, gopacket.Default)
+}
+
+func TestFullMarketPageThroughIPFragments(t *testing.T) {
+	row := `{"ItemTypeId":"T4_BAG","LocationId":"4002","UnitPriceSilver":10000,"Amount":1,"QualityLevel":1,"Padding":"` + strings.Repeat("x", 300) + `"}`
+	payload := []byte{0, 0, 0x47, 20}
+	for i := 0; i < 20; i++ {
+		n := uint32(len(row))
+		for n >= 128 {
+			payload = append(payload, byte(n)|128)
+			n >>= 7
+		}
+		payload = append(payload, byte(n))
+		payload = append(payload, row...)
+	}
+	photonPacket := buildPhotonPacket(photon.MsgResponse, byte(opAuctionGetOffers), payload)
+	ip := &layers.IPv4{Version: 4, IHL: 5, SrcIP: []byte{1, 2, 3, 4}, DstIP: []byte{5, 6, 7, 8}, Protocol: layers.IPProtocolUDP}
+	udp := &layers.UDP{SrcPort: 5056, DstPort: 6000}
+	udp.SetNetworkLayerForChecksum(ip)
+	b := gopacket.NewSerializeBuffer()
+	if err := gopacket.SerializeLayers(b, gopacket.SerializeOptions{FixLengths: true, ComputeChecksums: true}, ip, udp, gopacket.Payload(photonPacket)); err != nil {
+		t.Fatal(err)
+	}
+	data := append([]byte(nil), b.Bytes()[20:]...)
+	p := newCapturePipeline(newRouter(), &captureHealth{})
+	at := time.Now()
+	before := liveCaptureHealth.snapshot(at)
+	parts := (len(data) + 999) / 1000
+	for i := parts - 1; i >= 0; i-- {
+		start := i * 1000
+		end := start + 1000
+		if end > len(data) {
+			end = len(data)
+		}
+		part := ipFragmentFixture(t, 21, uint16(start/8), i < parts-1, data[start:end])
+		p.accept("vpn", part, at)
+		if i > 0 {
+			p.accept("vpn", part, at)
+		}
+	}
+	select {
+	case op := <-p.processor.router.newOperation:
+		op.Process(p.processor.router.albionstate)
+	default:
+		t.Fatal("reassembled page did not reach the operation router")
+	}
+	after := liveCaptureHealth.snapshot(at)
+	if after.MarketResponses-before.MarketResponses != 1 || after.MarketRows-before.MarketRows != 20 {
+		t.Fatal("complete 20-order page failed end-to-end IP/UDP/Photon decoding", before, after)
+	}
+}
+
+func TestCaptureFilterIncludesIPv4Continuations(t *testing.T) {
+	data := fragmentedGameUDP(t)
+	tail := ipFragmentFixture(t, 17, 125, false, data[1000:])
+	frame := make([]byte, 14)
+	frame[12] = 8
+	frame = append(frame, tail.Data()...)
+	info := gopacket.CaptureInfo{Length: len(frame), CaptureLength: len(frame)}
+	filter, err := pcap.NewBPF(layers.LinkTypeEthernet, 65535, gameCaptureFilter)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !filter.Matches(info, frame) {
+		t.Fatal("capture filter discards non-initial game UDP fragments")
+	}
+	old, err := pcap.NewBPF(layers.LinkTypeEthernet, 65535, "tcp port 5056 or udp port 5056")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if old.Matches(info, frame) {
+		t.Fatal("fixture must demonstrate the old port filter loss")
+	}
+}
+
+func TestIPFragmentsRejectConflictsAndBoundMemory(t *testing.T) {
+	data := fragmentedGameUDP(t)
+	stats := &captureHealth{}
+	p := newCapturePipeline(newRouter(), stats)
+	at := time.Now()
+	p.accept("vpn", ipFragmentFixture(t, 17, 125, false, data[1000:]), at)
+	changed := append([]byte(nil), data[1000:]...)
+	changed[0] ^= 1
+	p.accept("vpn", ipFragmentFixture(t, 17, 125, false, changed), at)
+	p.accept("vpn", ipFragmentFixture(t, 17, 0, true, data[:1000]), at)
+	if stats.snapshot(at).Encrypted != 0 || stats.snapshot(at).IPFragmentErrors != 1 {
+		t.Fatal("conflicting IP fragments were accepted")
+	}
+	for i := uint16(20); i < 70; i++ {
+		p.accept("vpn", ipFragmentFixture(t, i, 125, false, data[1000:]), at)
+	}
+	if len(p.ipFragments) > 32 {
+		t.Fatal("unbounded fragment buffers")
+	}
+	p.accept("vpn", ipFragmentFixture(t, 80, 125, false, data[1000:]), at.Add(31*time.Second))
+	if len(p.ipFragments) != 1 {
+		t.Fatal("stale fragments retained")
+	}
+}
+
+func fragmentedGameUDP(t *testing.T) []byte {
+	t.Helper()
+	ip := &layers.IPv4{Version: 4, IHL: 5, SrcIP: []byte{1, 2, 3, 4}, DstIP: []byte{5, 6, 7, 8}, Protocol: layers.IPProtocolUDP}
+	udp := &layers.UDP{SrcPort: 5056, DstPort: 6000}
+	udp.SetNetworkLayerForChecksum(ip)
+	data := make([]byte, 2000)
+	data[2] = 1 // encrypted Photon marker: counts once only after full UDP reassembly
+	b := gopacket.NewSerializeBuffer()
+	if err := gopacket.SerializeLayers(b, gopacket.SerializeOptions{FixLengths: true, ComputeChecksums: true}, ip, udp, gopacket.Payload(data)); err != nil {
+		t.Fatal(err)
+	}
+	return append([]byte(nil), b.Bytes()[20:]...)
+}
+
+func TestCaptureReassemblesIPv4BeforeTransportFilter(t *testing.T) {
+	data := fragmentedGameUDP(t)
+	stats := &captureHealth{}
+	p := newCapturePipeline(newRouter(), stats)
+	at := time.Now()
+	// Tail arrives before the first fragment; duplicate delivery must not complete it.
+	tail := ipFragmentFixture(t, 17, 125, false, data[1000:])
+	p.accept("vpn", tail, at)
+	p.accept("vpn", tail, at.Add(time.Millisecond))
+	if stats.snapshot(at).Encrypted != 0 {
+		t.Fatal("partial IP datagram decoded")
+	}
+	p.accept("vpn", ipFragmentFixture(t, 17, 0, true, data[:1000]), at.Add(2*time.Millisecond))
+	if stats.snapshot(at).Encrypted != 1 {
+		t.Fatal("large UDP response lost before Photon decoder")
+	}
+}
