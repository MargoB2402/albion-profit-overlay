+package client
+
+import (
+	"encoding/binary"
+	"github.com/google/gopacket"
+	"github.com/google/gopacket/layers"
+	"time"
+)
+
+// Non-initial IPv4 fragments have no UDP ports for BPF to inspect. Only a
+// complete datagram with an observed 5056 port is passed to the game decoder.
+const gameCaptureFilter = "tcp port 5056 or udp port 5056 or (ip proto 17 and (ip[6:2] & 0x1fff != 0))"
+const ipFragmentPayloadLimit = 65515
+
+type ipFragmentKey struct {
+	source, destination [4]byte
+	id                  uint16
+}
+type ipFragmentAssembly struct {
+	payload, covered    []byte
+	first               *layers.IPv4
+	total, unique, high int
+	at                  time.Time
+}
+
+func (p *capturePipeline) reassembleIP(packet gopacket.Packet, at time.Time) gopacket.Packet {
+	layer := packet.Layer(layers.LayerTypeIPv4)
+	if layer == nil {
+		return packet
+	}
+	ip := layer.(*layers.IPv4)
+	if ip.Flags&layers.IPv4MoreFragments == 0 && ip.FragOffset == 0 {
+		return packet
+	}
+	if ip.Protocol != layers.IPProtocolUDP {
+		return nil
+	}
+	p.stats.Lock()
+	p.stats.s.IPFragments++
+	p.stats.Unlock()
+	key := ipFragmentKey{id: ip.Id}
+	copy(key.source[:], ip.SrcIP.To4())
+	copy(key.destination[:], ip.DstIP.To4())
+	reject := func() gopacket.Packet {
+		delete(p.ipFragments, key)
+		p.stats.Lock()
+		p.stats.s.IPFragmentErrors++
+		p.stats.Unlock()
+		return nil
+	}
+	offset, size := int(ip.FragOffset)*8, len(ip.Payload)
+	more := ip.Flags&layers.IPv4MoreFragments != 0
+	if size == 0 || ip.IHL < 5 || int(ip.Length) != int(ip.IHL)*4+size || offset > ipFragmentPayloadLimit-size || more && size%8 != 0 {
+		return reject()
+	}
+	if offset == 0 && (size < 8 || binary.BigEndian.Uint16(ip.Payload[:2]) != 5056 && binary.BigEndian.Uint16(ip.Payload[2:4]) != 5056) {
+		delete(p.ipFragments, key)
+		return nil
+	}
+	for k, v := range p.ipFragments {
+		if at.Sub(v.at) > 30*time.Second {
+			delete(p.ipFragments, k)
+		}
+	}
+	a := p.ipFragments[key]
+	if a == nil {
+		if len(p.ipFragments) >= 32 {
+			var oldest ipFragmentKey
+			var stamp time.Time
+			for k, v := range p.ipFragments {
+				if stamp.IsZero() || v.at.Before(stamp) {
+					oldest, stamp = k, v.at
+				}
+			}
+			delete(p.ipFragments, oldest)
+		}
+		a = &ipFragmentAssembly{payload: make([]byte, ipFragmentPayloadLimit), covered: make([]byte, (ipFragmentPayloadLimit+7)/8), at: at}
+		p.ipFragments[key] = a
+	}
+	end := offset + size
+	if a.total > 0 && (end > a.total || !more && end != a.total) {
+		return reject()
+	}
+	if !more {
+		if end < a.high {
+			return reject()
+		}
+		a.total = end
+	}
+	if offset == 0 {
+		header := *ip
+		a.first = &header
+	}
+	for i, value := range ip.Payload {
+		pos := offset + i
+		mask := byte(1 << uint(pos%8))
+		if a.covered[pos/8]&mask != 0 {
+			if a.payload[pos] != value {
+				return reject()
+			}
+		} else {
+			a.covered[pos/8] |= mask
+			a.payload[pos] = value
+			a.unique++
+		}
+	}
+	if end > a.high {
+		a.high = end
+	}
+	if a.total == 0 || a.first == nil || a.unique != a.total {
+		return nil
+	}
+	if a.total < 8 || a.total > 65535-int(a.first.IHL)*4 || int(binary.BigEndian.Uint16(a.payload[4:6])) != a.total {
+		return reject()
+	}
+	header := *a.first
+	header.Flags &^= layers.IPv4MoreFragments
+	header.FragOffset = 0
+	buffer := gopacket.NewSerializeBuffer()
+	if err := gopacket.SerializeLayers(buffer, gopacket.SerializeOptions{FixLengths: true, ComputeChecksums: true}, &header, gopacket.Payload(a.payload[:a.total])); err != nil {
+		return reject()
+	}
+	delete(p.ipFragments, key)
+	p.stats.Lock()
+	p.stats.s.IPReassembled++
+	p.stats.Unlock()
+	return gopacket.NewPacket(buffer.Bytes(), layers.LayerTypeIPv4, gopacket.Default)
+}
