+func marketOrderCity(auctionID, playerID string) string {
+	if auctionID != "" {
+		// An explicit unknown auction must never inherit a previous city.
+		return marketLocationIDToCity(auctionID)
+	}
+	if city := marketLocationIDToCity(playerID); city != "unknown" {
+		return city
+	}
+	// Ordinary market rows can omit LocationId. A Join supplies a physical
+	// city ID (e.g. 4000), not necessarily its auction ID (4002).
+	return locationIDToCity(playerID)
 }
 
