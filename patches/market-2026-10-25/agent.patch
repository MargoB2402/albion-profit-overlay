+// Only aggregate counts leave the agent, never orders or packet contents.
+func (h *captureHealth) marketCount(kind string, n uint64) {
+	h.Lock()
+	defer h.Unlock()
+	switch kind {
+	case "request":
+		h.s.MarketRequests += n
+	case "response":
+		h.s.MarketResponses += n
+	case "rows":
+		h.s.MarketRows += n
+	case "error":
+		h.s.MarketErrors += n
+	case "json":
+		h.s.MarketJsonErrors += n
+	case "location":
+		h.s.MarketUnknownLocations += n
+	case "invalid":
+		h.s.MarketInvalidOrders += n
+	}
+}
 
