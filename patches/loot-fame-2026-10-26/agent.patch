+package client
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"math"
+)
+
+// UpdateFame (82). All award amounts except factor 17 use silver-style 1e4 units.
+func fameAward(p map[byte]interface{}, self int64) (float64, bool) {
+	if self == 0 || farmInt(p[0]) != self {
+		return 0, false
+	}
+	component := func(k byte, required bool) float64 {
+		v, exists := p[k]
+		if !exists && !required {
+			return 0
+		}
+		n, ok := farmNumber(v)
+		if !ok || n < 0 || n > 9007199254740991 || math.IsNaN(n) || math.IsInf(n, 0) {
+			return math.NaN()
+		}
+		return n / 10000
+	}
+	premium := 1.0
+	if v, exists := p[5]; exists {
+		b, ok := v.(bool)
+		if !ok {
+			return 0, false
+		}
+		if b {
+			premium = 1.5
+		}
+	}
+	factor := 0.0
+	if v, exists := p[17]; exists {
+		var ok bool
+		factor, ok = farmNumber(v)
+		if !ok || factor < -1 || math.IsNaN(factor) || math.IsInf(factor, 0) {
+			return 0, false
+		}
+	}
+	// p13 is a duplicated board credit; p1 is cumulative, neither is an award.
+	n := (component(2, true)*premium+component(10, false))*(1+factor) + component(12, false)
+	return n, n > 0 && n <= 1e12 && !math.IsNaN(n) && !math.IsInf(n, 0)
+}
+func (f *lootCapture) fame(p map[byte]interface{}, now int64) {
+	n, ok := fameAward(p, f.self)
+	if !ok {
+		return
+	}
+	if _, ok := p[1]; ok {
+		key := sha256.Sum256([]byte(fmt.Sprintf("fame|%s|%d|%v|%v|%v|%v|%v|%v", f.player, f.self, p[1], p[2], p[5], p[10], p[12], p[17])))
+		if !firstSilverObservation(key, now) {
+			return
+		}
+	}
+	r := map[string]interface{}{"id": farmUUID(), "kind": "fame", "at": now, "player": f.player, "fame": n}
+	if f.sink != nil {
+		f.sink(r)
+	} else {
+		getOverlayHub().broadcast(OverlayEvent{Type: "loot_fame", Payload: r})
+	}
+}
