+package client
+
+import (
+	"math"
+	"testing"
+)
+
+func TestFameAwards(t *testing.T) {
+	p := map[byte]interface{}{0: int64(-42), 1: int64(999999999999), 2: int64(900000), 5: true, 12: int64(5400000), 13: int64(10800000)}
+	if n, ok := fameAward(p, -42); !ok || n != 675 {
+		t.Fatalf("quick learn must count once: %v %v", n, ok)
+	}
+	if _, ok := fameAward(p, 42); ok {
+		t.Fatal("foreign actor")
+	}
+	p[10] = int64(100000)
+	p[17] = 1.0
+	if n, ok := fameAward(p, -42); !ok || n != 830 {
+		t.Fatalf("bonus: %v %v", n, ok)
+	}
+	p[17] = -2.0
+	if _, ok := fameAward(p, -42); ok {
+		t.Fatal("invalid factor")
+	}
+	delete(p, 17)
+	p[10] = math.NaN()
+	if _, ok := fameAward(p, -42); ok {
+		t.Fatal("invalid award")
+	}
+}
+func TestFameDedup(t *testing.T) {
+	f := newLootCapture()
+	f.self = -99
+	f.player = "fame fixture"
+	var rows []map[string]interface{}
+	f.sink = func(r map[string]interface{}) { rows = append(rows, r) }
+	p := map[byte]interface{}{0: int64(-99), 1: int64(123456), 2: int64(100000)}
+	f.event(82, p, 1000)
+	f.event(82, p, 1001)
+	if len(rows) != 1 {
+		t.Fatalf("duplicate fame: %d", len(rows))
+	}
+}
