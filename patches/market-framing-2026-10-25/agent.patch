+package client
+
+import (
+	"encoding/binary"
+	"testing"
+	"time"
+
+	"github.com/ao-data/albiondata-client/client/photon"
+)
+
+func TestCoalescedMarketResponsesThroughCapture(t *testing.T) {
+	row := `{"ItemTypeId":"T4_BAG","LocationId":"4002","UnitPriceSilver":10000,"Amount":1,"QualityLevel":1}`
+	var batch []byte
+	for i := 0; i < 20; i++ {
+		body := append([]byte{0, 0, 0x47, 1, byte(len(row))}, []byte(row)...)
+		batch = append(batch, buildPhotonPacket(photon.MsgResponse, byte(opAuctionGetOffers), body)...)
+	}
+	udp := make([]byte, 8)
+	binary.BigEndian.PutUint16(udp, 5056)
+	binary.BigEndian.PutUint16(udp[2:], 6000)
+	binary.BigEndian.PutUint16(udp[4:], uint16(8+len(batch)))
+	p := newCapturePipeline(newRouter(), &captureHealth{})
+	at := time.Now()
+	before := liveCaptureHealth.snapshot(at)
+	p.accept("adapter", ipFragmentFixture(t, 99, 0, false, append(udp, batch...)), at)
+	for i := 0; i < 20; i++ {
+		select {
+		case op := <-p.processor.router.newOperation:
+			op.Process(p.processor.router.albionstate)
+		default:
+			t.Fatalf("only %d of 20 market responses reached the router", i)
+		}
+	}
+	after := liveCaptureHealth.snapshot(at)
+	if after.MarketRows-before.MarketRows != 20 || after.MarketResponses-before.MarketResponses != 20 {
+		t.Fatal("coalesced rows lost", before, after)
+	}
+}
