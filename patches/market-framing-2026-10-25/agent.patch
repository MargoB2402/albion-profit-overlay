+package photon
+
+import (
+	"encoding/binary"
+	"hash/crc32"
+	"testing"
+)
+
+func framingPacket(code byte) []byte {
+	b := make([]byte, 29)
+	b[3], b[12] = 1, cmdSendReliable
+	binary.BigEndian.PutUint32(b[16:], 17)
+	copy(b[24:], []byte{0, MsgResponse, code, 0, 0})
+	return b
+}
+
+func crcPacket(b []byte) []byte {
+	out := append(append(append([]byte{}, b[:12]...), 0, 0, 0, 0), b[12:]...)
+	out[2] = 0xcc
+	binary.BigEndian.PutUint32(out[12:], ^crc32.ChecksumIEEE(out))
+	return out
+}
+
+func TestCoalescedPacketsDeliverEveryResponse(t *testing.T) {
+	for _, crc := range []bool{false, true} {
+		calls := 0
+		p := NewPhotonParser(nil, func(code byte, _ int16, _ string, _ map[byte]interface{}) {
+			calls++
+			if int(code) != calls {
+				t.Errorf("response order: got %d want %d", code, calls)
+			}
+		}, nil)
+		var batch []byte
+		for i := byte(1); i <= 20; i++ {
+			b := framingPacket(i)
+			if crc {
+				b = crcPacket(b)
+			}
+			batch = append(batch, b...)
+		}
+		if !p.ReceivePacket(batch) || calls != 20 {
+			t.Fatalf("crc=%v delivered %d of 20 responses", crc, calls)
+		}
+	}
+}
+
+func TestCoalescedFragmentsKeepAssemblyIdentity(t *testing.T) {
+	message := []byte{0, MsgResponse, 75, 0, 0, 0x47, 1, 2, '{', '}'}
+	for _, crc := range []bool{false, true} {
+		calls := 0
+		p := NewPhotonParser(nil, func(_ byte, _ int16, _ string, params map[byte]interface{}) {
+			calls++
+			orders, ok := params[0].([]string)
+			if !ok || len(orders) != 1 || orders[0] != "{}" {
+				t.Errorf("corrupt orders: %v", params)
+			}
+		}, nil)
+		var batch []byte
+		for i := 1; i >= 0; i-- {
+			b := fragmentPacket(2, 100, 2, uint32(i), uint32(len(message)), uint32(i*5), message[i*5:i*5+5])
+			b[1] = 9
+			binary.BigEndian.PutUint32(b[8:], 123)
+			if crc {
+				b = crcPacket(b)
+			}
+			batch = append(batch, b...)
+		}
+		if !p.ReceivePacket(batch) || calls != 1 {
+			t.Fatalf("crc=%v lost coalesced fragments, calls=%d", crc, calls)
+		}
+	}
+}
+
+func TestFramingRejectsBadCRCIdentityAndTruncation(t *testing.T) {
+	for _, kind := range []string{"crc", "identity", "short"} {
+		calls := 0
+		p := NewPhotonParser(nil, func(_ byte, _ int16, _ string, _ map[byte]interface{}) { calls++ }, nil)
+		first, next := framingPacket(1), framingPacket(2)
+		switch kind {
+		case "crc":
+			first = crcPacket(first)
+			first[12] ^= 1
+		case "identity":
+			next[1] = 1
+		case "short":
+			next = next[:len(next)-1]
+		}
+		if p.ReceivePacket(append(first, next...)) {
+			t.Errorf("accepted %s", kind)
+		}
+		if kind == "crc" && calls != 0 || kind != "crc" && calls != 1 {
+			t.Errorf("%s calls=%d", kind, calls)
+		}
+	}
+}
